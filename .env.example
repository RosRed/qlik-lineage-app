# ─── API Anthropic ──────────────────────────────────────────────────────
# Clé pour l'analyse des scripts Qlik via Claude
ANTHROPIC_API_KEY=sk-ant-...

# ─── Serveur ────────────────────────────────────────────────────────────
# Port d'écoute du backend Express (défaut 3001)
API_PORT=3001

# Origine autorisée pour CORS (URL du client en prod)
CLIENT_ORIGIN=http://localhost:5173

# Chemin de la base SQLite (par défaut ./data/lineage.db)
# DATABASE_PATH=/var/lib/qlik-lineage/lineage.db

# ─── Authentification ───────────────────────────────────────────────────
# Compte admin initial créé au 1er démarrage (si aucun user en base)
# ⚠️  À changer immédiatement après le 1er login puis retirer d'ici.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-strong-password-min-8-chars

# Désactive complètement l'authentification (DEV UNIQUEMENT)
# Ne JAMAIS mettre à true en production.
AUTH_DISABLED=false
